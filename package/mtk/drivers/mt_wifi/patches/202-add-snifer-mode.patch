+
+/* 辅助函数 */
+static const char *get_bw_str_print(UCHAR bw)
+{
+    switch(bw) {
+        case BW_20: return "20MHz";
+        case BW_40: return "40MHz";
+        case BW_80: return "80MHz";
+        case BW_160: return "160MHz";
+        default: return "Unknown";
+    }
+}
+
+static const char *get_phy_mode_str_print(UCHAR mode)
+{
+    switch(mode) {
+        case MODE_CCK: return "CCK";
+        case MODE_OFDM: return "OFDM";
+        case MODE_HTMIX: return "HT Mixed";
+        case MODE_HTGREENFIELD: return "HT Greenfield";
+        case MODE_VHT: return "VHT";
+        default: return "Unknown";
+    }
+}
+
+static void print_packet_info(RTMP_ADAPTER *pAd, RX_BLK *pRxBlk, CHAR Rssi)
+{
+    int i;
+    UCHAR *pData = pRxBlk->pData;
+    USHORT DataSize = pRxBlk->DataSize;
+    UCHAR Channel = pAd->ApCfg.MBSSID[0].wdev.channel;
+    HTTRANSMIT_SETTING rx_rate = pRxBlk->rx_rate;
+    
+    printk(KERN_INFO "\n===== 802.11 Packet Dump =====\n");
+    
+    /* 基本信息 */
+    printk(KERN_INFO "Size: %d, RSSI: %d, Channel: %d\n", 
+           DataSize, Rssi, Channel);
+    
+    /* 速率信息 */
+    printk(KERN_INFO "PHY Mode: %s, BW: %s, MCS: %d, %sGI, %sSTBC, %sLDPC\n",
+           get_phy_mode_str_print(rx_rate.field.MODE),
+           get_bw_str_print(rx_rate.field.BW),
+           rx_rate.field.MCS,
+           rx_rate.field.ShortGI ? "Short" : "Long",
+           rx_rate.field.STBC ? "" : "No ",
+           rx_rate.field.ldpc ? "" : "No ");
+    
+    /* 源/目的地址 */
+    if (pRxBlk->Addr1 && pRxBlk->Addr2) {
+        printk(KERN_INFO "DA: %02x:%02x:%02x:%02x:%02x:%02x\n",
+               pRxBlk->Addr1[0], pRxBlk->Addr1[1], pRxBlk->Addr1[2],
+               pRxBlk->Addr1[3], pRxBlk->Addr1[4], pRxBlk->Addr1[5]);
+        printk(KERN_INFO "SA: %02x:%02x:%02x:%02x:%02x:%02x\n",
+               pRxBlk->Addr2[0], pRxBlk->Addr2[1], pRxBlk->Addr2[2],
+               pRxBlk->Addr2[3], pRxBlk->Addr2[4], pRxBlk->Addr2[5]);
+    }
+    
+    /* 数据包标志 */
+    printk(KERN_INFO "Flags: %s%s%s%s%s%s%s\n",
+           (pRxBlk->Flags & fRX_AMPDU) ? "AMPDU " : "",
+           (pRxBlk->Flags & fRX_AMSDU) ? "AMSDU " : "",
+           (pRxBlk->Flags & fRX_QOS) ? "QoS " : "",
+           (pRxBlk->Flags & fRX_AP) ? "FromAP " : "",
+           (pRxBlk->Flags & fRX_STA) ? "FromSTA " : "",
+           (pRxBlk->Flags & fRX_ICV_ERR) ? "ICV_ERR " : "",
+           (pRxBlk->Flags & fRX_TKIP_MIC_ERR) ? "MIC_ERR " : "");
+    
+ /* 数据内容 (全部数据) */
+    printk(KERN_INFO "Packet Data (%d bytes):\n", DataSize);
+    for (i = 0; i < DataSize; i++) {
+        printk("%02x ", pData[i]);
+        if ((i + 1) % 16 == 0)
+            printk("\n");
+    }
+    /* 确保最后一行有换行 */
+    if (DataSize % 16 != 0)
+        printk("\n");
+		
+    printk(KERN_INFO "\n==============================\n");
+}
+
+static void send_packet_info(RTMP_ADAPTER *pAd, RX_BLK *pRxBlk, CHAR Rssi)
+{
+    int i;
+    UCHAR *pData = pRxBlk->pData;
+    USHORT DataSize = pRxBlk->DataSize;
+    UCHAR Channel = pAd->ApCfg.MBSSID[0].wdev.channel;
+    HTTRANSMIT_SETTING rx_rate = pRxBlk->rx_rate;
+    
+    // 计算需要的缓冲区大小
+    size_t info_len = 512 + DataSize * 3; // 预留足够空间
+    unsigned char *buffer = kmalloc(info_len, GFP_ATOMIC);
+    if (!buffer) {
+        printk(KERN_ERR "Failed to allocate info buffer\n");
+        return;
+    }
+    
+    int pos = 0;
+    
+    // 格式化基本信息
+    pos += snprintf(buffer + pos, info_len - pos, 
+                   "\n===== 802.11 Packet Dump =====\n"
+                   "Size: %d, RSSI: %d, Channel: %d\n",
+                   DataSize, Rssi, Channel);
+    
+    // 格式化速率信息
+    pos += snprintf(buffer + pos, info_len - pos,
+                   "PHY Mode: %s, BW: %s, MCS: %d, %sGI, %sSTBC, %sLDPC\n",
+                   get_phy_mode_str_print(rx_rate.field.MODE),
+                   get_bw_str_print(rx_rate.field.BW),
+                   rx_rate.field.MCS,
+                   rx_rate.field.ShortGI ? "Short" : "Long",
+                   rx_rate.field.STBC ? "" : "No ",
+                   rx_rate.field.ldpc ? "" : "No ");
+    
+    // 源/目的地址
+    if (pRxBlk->Addr1 && pRxBlk->Addr2) {
+        pos += snprintf(buffer + pos, info_len - pos,
+                       "DA: %02x:%02x:%02x:%02x:%02x:%02x\n",
+                       pRxBlk->Addr1[0], pRxBlk->Addr1[1], pRxBlk->Addr1[2],
+                       pRxBlk->Addr1[3], pRxBlk->Addr1[4], pRxBlk->Addr1[5]);
+        pos += snprintf(buffer + pos, info_len - pos,
+                       "SA: %02x:%02x:%02x:%02x:%02x:%02x\n",
+                       pRxBlk->Addr2[0], pRxBlk->Addr2[1], pRxBlk->Addr2[2],
+                       pRxBlk->Addr2[3], pRxBlk->Addr2[4], pRxBlk->Addr2[5]);
+    }
+    
+    // 数据包标志
+    pos += snprintf(buffer + pos, info_len - pos,
+                   "Flags: %s%s%s%s%s%s%s\n",
+                   (pRxBlk->Flags & fRX_AMPDU) ? "AMPDU " : "",
+                   (pRxBlk->Flags & fRX_AMSDU) ? "AMSDU " : "",
+                   (pRxBlk->Flags & fRX_QOS) ? "QoS " : "",
+                   (pRxBlk->Flags & fRX_AP) ? "FromAP " : "",
+                   (pRxBlk->Flags & fRX_STA) ? "FromSTA " : "",
+                   (pRxBlk->Flags & fRX_ICV_ERR) ? "ICV_ERR " : "",
+                   (pRxBlk->Flags & fRX_TKIP_MIC_ERR) ? "MIC_ERR " : "");
+    
+    // 数据内容
+    pos += snprintf(buffer + pos, info_len - pos,
+                   "Packet Data (%d bytes):\n", DataSize);
+    
+    // 发送格式化后的信息
+    send_to_user(buffer, pos);
+    
+    // 发送原始数据（十六进制格式）
+    unsigned char *hex_data = kmalloc(DataSize * 3 + 1, GFP_ATOMIC);
+    if (hex_data) {
+        for (i = 0; i < DataSize; i++) {
+            snprintf(hex_data + i*3, 4, "%02X ", pData[i]);
+        }
+        send_to_user(hex_data, DataSize * 3);
+        kfree(hex_data);
+    }
+    
+    // 发送结束标记
+    send_to_user((unsigned char *)"\n==============================\n", 33);
+    
+    kfree(buffer);
+}

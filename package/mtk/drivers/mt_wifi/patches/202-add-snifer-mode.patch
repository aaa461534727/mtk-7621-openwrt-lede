@@ -6214,28 +6214,37 @@ NDIS_STATUS header_packet_process(
 static struct sock *nl_sk = NULL;
 static int user_pid = -1;  // 保存用户空间PID
 
-// 发送消息到用户空间
+// 修改send_to_user函数，增加分片支持
 void send_to_user(const unsigned char *data, size_t len) {
     struct sk_buff *skb_out;
     struct nlmsghdr *nlh;
+    size_t chunk_size;
+    size_t sent = 0;
+    
     if (user_pid == -1) {
-        //printk(KERN_INFO "No registered user\n");
         return;
     }
 
-	// 创建消息缓冲区（注意：长度不带字符串终止符）
-	skb_out = nlmsg_new(len, 0); // len为实际二进制数据长度
-	if (!skb_out) {
-		printk(KERN_ERR "Failed to allocate skb\n");
-		return;
-	}
-
-    // 填充消息头
-    nlh = nlmsg_put(skb_out, 0, 0, NLMSG_DONE, len, 0);
-    memcpy(nlmsg_data(nlh), data, len); // 使用memcpy
-
-    // 发送单播消息
-    nlmsg_unicast(nl_sk, skb_out, user_pid);
+    // 分片发送，每片不超过1024字节
+    while (sent < len) {
+        chunk_size = min_t(size_t, len - sent, 1024);
+        
+        skb_out = nlmsg_new(chunk_size, GFP_ATOMIC);
+        if (!skb_out) {
+            printk(KERN_ERR "Failed to allocate skb\n");
+            return;
+        }
+
+        nlh = nlmsg_put(skb_out, 0, 0, NLMSG_DONE, chunk_size, 0);
+        memcpy(nlmsg_data(nlh), data + sent, chunk_size);
+        
+        if (nlmsg_unicast(nl_sk, skb_out, user_pid) < 0) {
+            printk(KERN_ERR "Failed to send netlink message\n");
+            return;
+        }
+        
+        sent += chunk_size;
+    }
 }
 
